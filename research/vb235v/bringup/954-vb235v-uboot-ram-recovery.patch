diff --git a/net/lwip/httpd-ram.c b/net/lwip/httpd-ram.c
new file mode 100644
index 00000000..c9970f51
--- /dev/null
+++ b/net/lwip/httpd-ram.c
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* VB235v development recovery: uploads live only in allocated RAM. */
+#include <command.h>
+#include <console.h>
+#include <env.h>
+#include <malloc.h>
+#include <net.h>
+#include <net-lwip.h>
+#include <net/httpd.h>
+#include <u-boot/sha256.h>
+#include <lwip/apps/fs.h>
+#include <lwip/apps/httpd.h>
+#include <lwip/pbuf.h>
+
+#define RAM_UPLOAD_LIMIT (16U * 1024 * 1024)
+
+static void *upload_connection;
+static unsigned char *upload_buffer;
+static size_t upload_expected, upload_received, upload_ready;
+static bool upload_failed, running;
+static char upload_hash[SHA256_SUM_LEN * 2 + 1];
+
+static const char page[] =
+ "<!doctype html><meta charset=utf-8><title>VB235v RAM recovery</title>"
+ "<style>body{font:18px system-ui;max-width:48em;margin:3em auto;padding:1em}"
+ "button,input{font:inherit;margin:.5em}pre{white-space:pre-wrap}</style>"
+ "<h1>VB235v RAM recovery / 内存恢复开发版</h1>"
+ "<p>文件仅接收到内存，最大 16 MiB。此页面不刷写闪存、不执行命令。"
+ "上传不会自动启动；返回串口后需另行核对镜像和地址。</p>"
+ "<input id=f type=file><button id=u>上传到 RAM</button><pre id=s></pre>"
+ "<script>const s=document.getElementById('s');"
+ "document.getElementById('u').onclick=async()=>{"
+ "const f=document.getElementById('f').files[0];if(!f)return;"
+ "if(!f.size||f.size>16777216){s.textContent='文件大小无效';return;}"
+ "document.getElementById('u').disabled=true;try{"
+ "s.textContent='正在上传';let r=await fetch('/api/upload',"
+ "{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:f});"
+ "let t=await r.json();s.textContent=JSON.stringify(t,null,2);"
+ "if(t.ready&&window.crypto&&crypto.subtle){let d=await crypto.subtle.digest('SHA-256',await f.arrayBuffer());"
+ "let h=Array.from(new Uint8Array(d),x=>x.toString(16).padStart(2,'0')).join('');"
+ "s.textContent+='\\n本机 SHA-256: '+h+'\\n'+(h===t.sha256?'校验一致':'校验不一致');}"
+ "}catch(e){s.textContent=String(e);}finally{"
+ "document.getElementById('u').disabled=false;}};</script>";
+
+static void clear_ready(void)
+{
+	upload_ready = 0;
+	upload_hash[0] = '\0';
+	env_set("fileaddr", NULL);
+	env_set("filesize", NULL);
+}
+
+static int response(struct fs_file *file, const char *body,
+		    const char *type, int status)
+{
+	size_t len = strlen(body);
+	char *data = malloc(len + 192);
+	int head;
+
+	if (!data)
+		return 0;
+	head = snprintf(data, 192, "HTTP/1.1 %d %s\r\nContent-Type: %s\r\n"
+			"Content-Length: %zu\r\nCache-Control: no-store\r\n"
+			"Connection: close\r\n\r\n", status,
+			status == 200 ? "OK" : "Error", type, len);
+	memcpy(data + head, body, len);
+	file->data = data;
+	file->len = head + len;
+	file->index = file->len;
+	file->flags = FS_FILE_FLAGS_HEADER_INCLUDED;
+	file->pextension = data;
+	return 1;
+}
+
+int fs_open_custom(struct fs_file *file, const char *name)
+{
+	char body[256];
+
+	if (!strcmp(name, "/") || !strcmp(name, "/index.html"))
+		return response(file, page, "text/html; charset=utf-8", 200);
+	if (!strcmp(name, "/api/device"))
+		return response(file, "{\"model\":\"VB235v development\","
+			"\"ram_only\":true,\"flash\":false,\"execute\":false,"
+			"\"max_upload\":16777216}", "application/json", 200);
+	if (!strcmp(name, "/api/status")) {
+		snprintf(body, sizeof(body), "{\"ready\":%s,\"receiving\":%s,"
+			 "\"bytes\":%zu,\"address\":\"0x%lx\",\"sha256\":\"%s\"}",
+			 upload_ready ? "true" : "false",
+			 upload_connection ? "true" : "false", upload_ready,
+			 upload_ready ? (ulong)upload_buffer : 0, upload_hash);
+		return response(file, body, "application/json", 200);
+	}
+	return response(file, "{\"error\":\"unsupported request\"}",
+			"application/json", 400);
+}
+
+void fs_close_custom(struct fs_file *file)
+{
+	free(file->pextension);
+	file->pextension = NULL;
+}
+
+int fs_read_custom(struct fs_file *file, char *buffer, int count)
+{
+	return FS_READ_EOF;
+}
+
+err_t httpd_post_begin(void *connection, const char *uri,
+		       const char *request, u16_t request_len, int content_len,
+		       char *response_uri, u16_t response_len, u8_t *auto_wnd)
+{
+	unsigned char *new_buffer;
+
+	strlcpy(response_uri, "/api/error", response_len);
+	if (!connection || upload_connection || strcmp(uri, "/api/upload") ||
+	    content_len <= 0 || content_len > RAM_UPLOAD_LIMIT)
+		return ERR_ARG;
+	clear_ready();
+	free(upload_buffer);
+	upload_buffer = NULL;
+	new_buffer = malloc(content_len);
+	if (!new_buffer)
+		return ERR_MEM;
+	upload_buffer = new_buffer;
+	upload_connection = connection;
+	upload_expected = content_len;
+	upload_received = 0;
+	upload_failed = false;
+	*auto_wnd = 1;
+	return ERR_OK;
+}
+
+err_t httpd_post_receive_data(void *connection, struct pbuf *p)
+{
+	u16_t copied;
+	size_t len;
+
+	if (!p)
+		return ERR_ARG;
+	len = p->tot_len;
+	if (connection != upload_connection || !upload_connection) {
+		pbuf_free(p);
+		return ERR_ARG;
+	}
+	if (upload_failed || len > upload_expected - upload_received) {
+		upload_failed = true;
+		pbuf_free(p);
+		return ERR_ARG;
+	}
+	copied = pbuf_copy_partial(p, upload_buffer + upload_received, len, 0);
+	pbuf_free(p);
+	if (copied != len) {
+		upload_failed = true;
+		return ERR_ARG;
+	}
+	upload_received += len;
+	return ERR_OK;
+}
+
+void httpd_post_finished(void *connection, char *response_uri, u16_t len)
+{
+	unsigned char hash[SHA256_SUM_LEN];
+	int i;
+
+	strlcpy(response_uri, "/api/error", len);
+	if (!upload_connection || connection != upload_connection)
+		return;
+	if (!upload_failed && upload_received == upload_expected) {
+		sha256_csum_wd(upload_buffer, upload_received, hash, CHUNKSZ_SHA256);
+		for (i = 0; i < SHA256_SUM_LEN; i++)
+			sprintf(upload_hash + i * 2, "%02x", hash[i]);
+		if (!env_set_hex("fileaddr", (ulong)upload_buffer) &&
+		    !env_set_hex("filesize", upload_received)) {
+			upload_ready = upload_received;
+			strlcpy(response_uri, "/api/status", len);
+			printf("RAM upload: %zu bytes at %p, SHA256 %s\n",
+			       upload_ready, upload_buffer, upload_hash);
+		} else {
+			clear_ready();
+		}
+	}
+	upload_connection = NULL;
+}
+
+bool uboot_httpd_is_running(void)
+{
+	return running;
+}
+
+int uboot_httpd_start(bool with_dhcp)
+{
+	struct udevice *dev;
+	struct netif *netif;
+	int ret = 0;
+
+	if (running)
+		return -EBUSY;
+	if (with_dhcp)
+		return -EOPNOTSUPP;
+	if (env_set("ipaddr", CONFIG_HTTPD_SERVER_IP) ||
+	    env_set("netmask", CONFIG_HTTPD_SERVER_NETMASK))
+		return -ENOMEM;
+	ret = net_lwip_eth_start();
+	if (ret)
+		return ret;
+	dev = eth_get_dev();
+	netif = net_lwip_new_netif(dev);
+	if (!netif) {
+		net_lwip_eth_stop();
+		return -ENODEV;
+	}
+	running = true;
+	httpd_init();
+	printf("VB235v RAM-only HTTP: http://%s/ (static IP, Ctrl-C exits)\n",
+	       CONFIG_HTTPD_SERVER_IP);
+	clear_ctrlc();
+	while (!ctrlc()) {
+		ret = net_lwip_rx(dev, netif);
+		if (ret == -ENETDOWN || ret == -ENOLINK)
+			ret = 0;
+		if (ret < 0)
+			break;
+	}
+	httpd_stop();
+	if (upload_connection) {
+		upload_connection = NULL;
+		clear_ready();
+	}
+	net_lwip_remove_netif(netif);
+	net_lwip_eth_stop();
+	running = false;
+	clear_ctrlc();
+	return ret < 0 ? ret : 0;
+}
