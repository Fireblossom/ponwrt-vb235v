+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/ {
+	model = "TP-Link VB235v RAM recovery development";
+	compatible = "tplink,vb235v-ram-development", "airoha,an7583";
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases { serial0 = &uart; };
+	chosen {
+		stdout-path = "serial0:115200n8";
+		u-boot,usable-memory-range = <0 0x80200000 0 0x1fe00000>;
+	};
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x20000000>;
+	};
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		atf@80000000 { reg = <0 0x80000000 0 0x200000>; no-map; };
+		npu@84000000 { reg = <0 0x84000000 0 0x100000>; no-map; };
+		logs@8b000000 { reg = <0 0x8b000000 0 0x200000>; no-map; };
+	};
+	psci { compatible = "arm,psci-1.0"; method = "smc"; };
+	timer {
+		compatible = "arm,armv8-timer";
+		clock-frequency = <25000000>;
+	};
+	uart: serial@1fbf0000 {
+		compatible = "ns16550a";
+		reg = <0 0x1fbf0000 0 0x30>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clock-frequency = <1843200>;
+		bootph-all;
+	};
+};
