+ "if(!/^[a-f0-9]{64}$/.test(h))throw Error('请先用本机工具计算并填写 SHA-256');"
+ "if(state.active_slot!==0&&state.active_slot!==1)throw Error('活动槽未识别');"
+ "let r=await fetch('/api/install/'+(state.active_slot^1)+'/'+h,{method:'POST',body:'!'});"
+ "result.textContent=await r.text();}catch(e){result.textContent=String(e);}};"
