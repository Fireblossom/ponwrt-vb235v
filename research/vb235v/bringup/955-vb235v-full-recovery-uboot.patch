+
+static void status(void)
+{
+	snprintf(status_json, sizeof(status_json),
+		"{\"storage\":\"%s\",\"active_slot\":%d,\"ready_bytes\":%u,"
+		"\"sha256\":\"%s\",\"operation_result\":%d,\"pending\":%s}",
+		vb_storage_status(), vb_active_slot(), ready_bytes, digest,
+		operation_result, pending_slot >= 0 || pending_boot ? "true" : "false");
+}
+
+static int response(struct fs_file *file, const char *body, const char *type, int code)
+{
+	struct owner *owner = calloc(1, sizeof(*owner));
+	size_t len = strlen(body);
+	int head;
+
+	if (!owner)
+		return 0;
+	owner->allocated = malloc(len + 256);
+	if (!owner->allocated) {
+		free(owner);
+		return 0;
+	}
+	head = snprintf(owner->allocated, 256,
+		"HTTP/1.1 %d %s\r\nContent-Type: %s\r\nContent-Length: %zu\r\n"
+		"Cache-Control: no-store\r\nConnection: close\r\n\r\n",
+		code, code == 200 ? "OK" : "Error", type, len);
+	memcpy(owner->allocated + head, body, len);
+	file->data = owner->allocated;
+	file->len = head + len;
+	file->index = file->len;
+	file->flags = FS_FILE_FLAGS_HEADER_INCLUDED;
+	file->pextension = owner;
+	return 1;
+}
+
+int fs_open_custom(struct fs_file *file, const char *path)
+{
+	const struct vb_target *target;
+	struct owner *owner;
+	u8 check;
+
+	client_seen = true;
+	if (!strcmp(path, "/") || !strcmp(path, "/index.html")) {
+		client_seen = true;
+		return response(file, page, "text/html; charset=utf-8", 200);
+	}
+	if (!strcmp(path, "/api/status") || !strcmp(path, "/api/queued")) {
+		status();
+		int ok = response(file, status_json, "application/json", 200);
+		if (ok && !strcmp(path, "/api/queued"))
+			((struct owner *)file->pextension)->task_reply = true;
+		return ok;
+	}
+	if (!strncmp(path, "/api/backup/", 12)) {
+		if (receiving || pending_slot >= 0 || pending_boot || downloads)
+			return response(file, "{\"error\":\"busy\"}", "application/json", 409);
+		target = vb_target_find(path + 12);
+		if (!target || vb_storage_read(target, 0, &check, 1))
+			return response(file, "{\"error\":\"backup unavailable\"}", "application/json", 400);
+		owner = calloc(1, sizeof(*owner));
+		if (!owner)
+			return 0;
+		owner->target = target;
+		owner->length = target->size;
+		owner->header_length = snprintf(owner->header, sizeof(owner->header),
+			"HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n"
+			"Content-Length: %u\r\nContent-Disposition: attachment; filename=\"%s.bin\"\r\n"
+			"Cache-Control: no-store\r\nConnection: close\r\n\r\n", target->size, target->name);
+		file->data = NULL;
+		file->len = owner->header_length + target->size;
+		file->index = 0;
+		file->flags = FS_FILE_FLAGS_HEADER_INCLUDED;
+		file->pextension = owner;
+		downloads++;
+		return 1;
+	}
+	/* Let lwIP try its next default index before returning 404. */
+	if (strncmp(path, "/api/", 5))
+		return 0;
+	return response(file, "{\"error\":\"unsupported request\"}", "application/json", 400);
+}
+
+void fs_close_custom(struct fs_file *file)
+{
+	struct owner *owner = file->pextension;
+
+	if (!owner)
+		return;
+	if (owner->target)
+		downloads--;
+	if (owner->task_reply)
+		awaiting_reply = false;
+	free(owner->allocated);
+	free(owner);
+	file->pextension = NULL;
+}
+
+int fs_read_custom(struct fs_file *file, char *buffer, int count)
+{
+	struct owner *owner = file->pextension;
+	u32 length;
+	int ret;
+
+	if (!owner || !owner->target || count <= 0 || file->index >= file->len)
+		return FS_READ_EOF;
+	if (file->index < owner->header_length) {
+		length = min(count, owner->header_length - file->index);
+		memcpy(buffer, owner->header + file->index, length);
+	} else {
+		length = min_t(u32, count, owner->length - owner->position);
+		ret = vb_storage_read(owner->target, owner->position, buffer, length);
+		if (ret) {
+			operation_result = ret;
+			return FS_READ_EOF;
+		}
+		owner->position += length;
+	}
+	file->index += length;
+	return length;
+}
+
+err_t httpd_post_begin(void *connection, const char *path, const char *request,
+		       u16_t request_len, int length, char *reply, u16_t reply_len, u8_t *wnd)
+{
+	int i;
+
+	strlcpy(reply, "/api/error", reply_len);
+	if (!connection || receiving || downloads || pending_slot >= 0 || pending_boot)
+		return ERR_ARG;
+	if (!strcmp(path, "/api/upload") && length > 0 && length <= MAX_UPLOAD) {
+		post_kind = POST_UPLOAD;
+		ready_bytes = 0;
+		digest[0] = 0;
+		receiving = connection;
+		expected_bytes = length;
+		received_bytes = 0;
+		failed = false;
+		*wnd = 1;
+		return ERR_OK;
+	}
+	if (!strncmp(path, "/api/install/", 13) && strlen(path) == 79 &&
+	    (path[13] == '0' || path[13] == '1') && path[14] == '/' && length == 1 && ready_bytes) {
+		for (i = 15; i < 79; i++)
+			if (!((path[i] >= '0' && path[i] <= '9') || (path[i] >= 'a' && path[i] <= 'f')))
+				return ERR_ARG;
+		if (strcmp(digest, path + 15) || vb_fit_validate((void *)UPLOAD_ADDRESS, ready_bytes))
+			return ERR_ARG;
+		/* Queuing happens only after the one-byte request body completes. */
+		receiving = connection;
+		expected_bytes = 1;
+		received_bytes = 0;
+		failed = false;
+		operation_result = path[13] - '0';
+		post_kind = POST_INSTALL;
+		*wnd = 1;
+		return ERR_OK;
+	}
+	if (!strcmp(path, "/api/boot") && length == 1) {
+		receiving = connection;
+		expected_bytes = 1;
+		received_bytes = 0;
+		operation_result = 2;
+		post_kind = POST_BOOT;
+		failed = false;
+		*wnd = 1;
+		return ERR_OK;
+	}
+	return ERR_ARG;
+}
+
+err_t httpd_post_receive_data(void *connection, struct pbuf *p)
+{
+	u32 length;
+	u16_t copied;
+	u8 control;
+
+	if (!p)
+		return ERR_ARG;
+	length = p->tot_len;
+	if (!receiving || connection != receiving || failed || length > expected_bytes - received_bytes) {
+		if (connection == receiving)
+			failed = true;
+		pbuf_free(p);
+		return ERR_ARG;
+	}
+	if (post_kind != POST_UPLOAD) {
+		copied = pbuf_copy_partial(p, &control, length, 0);
+		if (copied != length || (length && control != '!'))
+			failed = true;
+	} else {
+		copied = pbuf_copy_partial(p, (void *)(UPLOAD_ADDRESS + received_bytes), length, 0);
+		if (copied != length)
+			failed = true;
+	}
+	pbuf_free(p);
+	received_bytes += length;
+	return failed ? ERR_ARG : ERR_OK;
+}
+
+void httpd_post_finished(void *connection, char *reply, u16_t length)
+{
+	u8 hash[32];
+	int i;
+
+	strlcpy(reply, "/api/error", length);
+	if (!receiving || connection != receiving)
+		return;
+	if (!failed && received_bytes == expected_bytes) {
+		if (post_kind != POST_UPLOAD) {
+			awaiting_reply = true;
+			if (post_kind == POST_BOOT)
+				pending_boot = true;
+			else
+				pending_slot = operation_result;
+		} else {
+			sha256_csum_wd((void *)UPLOAD_ADDRESS, received_bytes, hash, CHUNKSZ_SHA256);
+			for (i = 0; i < 32; i++)
+				sprintf(digest + i * 2, "%02x", hash[i]);
+			ready_bytes = received_bytes;
+			operation_result = 0;
+		}
+		strlcpy(reply, post_kind == POST_UPLOAD ? "/api/status" : "/api/queued", length);
+	}
+	receiving = NULL;
+}
+
+bool uboot_httpd_is_running(void) { return running; }
+
+int uboot_httpd_start(bool with_dhcp)
+{
+	struct udevice *device;
+	struct netif *netif;
+	ulong started;
+	int ret;
+
+	if (running)
+		return -EBUSY;
+	/* The fixed upload window is below relocated U-Boot and its 64 MiB heap. */
+	if (gd->ram_base != 0x80000000 || gd->ram_size != 0x20000000 ||
+	    gd->start_addr_sp < UPLOAD_ADDRESS + MAX_UPLOAD)
+		return -ENOMEM;
+	/* Volatile overrides also allow recovery on a host link-local subnet. */
+	if (env_set("ipaddr", env_get("httpd_ipaddr") ?: CONFIG_HTTPD_SERVER_IP) ||
+	    env_set("netmask", env_get("httpd_netmask") ?: CONFIG_HTTPD_SERVER_NETMASK))
+		return -ENOMEM;
+	vb_storage_init();
+	ret = net_lwip_eth_start();
+	if (ret)
+		return ret;
+	device = eth_get_dev();
+	netif = net_lwip_new_netif(device);
+	if (!netif) {
+		net_lwip_eth_stop();
+		return -ENODEV;
+	}
+	running = true;
+	client_seen = false;
+	started = get_timer(0);
+	httpd_init();
+	if (with_dhcp && uboot_httpd_dhcp_start(netif))
+		puts("Recovery DHCP server unavailable; static addressing remains available\n");
+	printf("VB235v recovery: http://%s/; Ctrl-C returns to serial\n", env_get("ipaddr"));
+	clear_ctrlc();
+	while (!ctrlc()) {
+		if (auto_window && !client_seen && get_timer(started) >= 15000)
+			break;
+		ret = net_lwip_rx(device, netif);
+		if (ret == -ENETDOWN || ret == -ENOLINK)
+			ret = 0;
+		if (ret < 0)
+			break;
+		if (pending_slot >= 0 && !awaiting_reply) {
+			operation_result = vb_storage_install(pending_slot, (void *)UPLOAD_ADDRESS, ready_bytes, digest);
+			pending_slot = -1;
+		}
+		if (pending_boot && !awaiting_reply)
+			break;
+	}
+	uboot_httpd_dhcp_stop();
+	httpd_stop();
+	receiving = NULL;
+	net_lwip_remove_netif(netif);
+	net_lwip_eth_stop();
+	running = false;
+	clear_ctrlc();
+	if (pending_boot && !awaiting_reply) {
+		pending_boot = false;
+		return vb_boot();
+	}
+	pending_slot = -1;
+	pending_boot = false;
+	awaiting_reply = false;
+	return ret < 0 ? ret : 0;
+}
+
+int vb_httpd_window(void)
+{
+	int ret;
+
+	auto_window = true;
+	ret = uboot_httpd_start(true);
+	auto_window = false;
+	return ret;
+}
