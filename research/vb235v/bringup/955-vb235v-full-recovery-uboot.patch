diff --git a/board/airoha/an7583/vb235v-factory.c b/board/airoha/an7583/vb235v-factory.c
new file mode 100644
index 00000000..7d7231f9
--- /dev/null
+++ b/board/airoha/an7583/vb235v-factory.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <asm/global_data.h>
+#include <command.h>
+#include <image.h>
+#include <lzma/LzmaTools.h>
+#include <malloc.h>
+#include <asm/unaligned.h>
+#include <u-boot/crc.h>
+#include <u-boot/sha256.h>
+#include <vb235v-recovery.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int vb_factory_boot(void)
+{
+	const struct vb_target *boot = vb_target_find("bootloader");
+	u8 *compressed = malloc(310799);
+	u8 hash[32];
+	char hex[65];
+	struct legacy_img_hdr *header = (void *)0x81dfff80;
+	u8 *arm64 = (void *)0x81dfffc0;
+	SizeT size = 903008;
+	int i, ret;
+
+	if (!compressed)
+		return -ENOMEM;
+	ret = vb_storage_read(boot, 0x2f800, compressed, 310799);
+	if (ret)
+		goto out;
+	sha256_csum_wd(compressed, 310799, hash, CHUNKSZ_SHA256);
+	for (i = 0; i < 32; i++)
+		sprintf(hex + i * 2, "%02x", hash[i]);
+	if (strcmp(hex, "b4daaf52ff8224cd8b577f72d769adb12823d536e2408d77919e6c9940fc388b")) {
+		ret = -EBADMSG;
+		goto out;
+	}
+	ret = lzmaBuffToBuffDecompress((void *)0x81e00000, &size, compressed, 310799);
+	if (ret || size != 903008) {
+		ret = -EBADMSG;
+		goto out;
+	}
+	sha256_csum_wd((void *)0x81e00000, size, hash, CHUNKSZ_SHA256);
+	for (i = 0; i < 32; i++)
+		sprintf(hex + i * 2, "%02x", hash[i]);
+	if (strcmp(hex, "e7e36e39ad9f97b379b8a1a8efc0fd7547add8da75b9a125ac1a28479ffbec8b")) {
+		ret = -EBADMSG;
+		goto out;
+	}
+	/* Keep the original BL33 byte-exact at its linked address.
+	 * A 64-byte Linux ARM64 header immediately below it permits bootm
+	 * to perform the normal cache/MMU/exception-level handoff.
+	 */
+	memset(arm64, 0, 64);
+	put_unaligned_le32(0x14000010, arm64); /* b +64 to original BL33 */
+	put_unaligned_le64(0x1dfffc0, arm64 + 8);
+	put_unaligned_le64(size + 64, arm64 + 16);
+	put_unaligned_le32(0x644d5241, arm64 + 56);
+	memset(header, 0, sizeof(*header));
+	image_set_magic(header, IH_MAGIC);
+	image_set_size(header, size + 64);
+	image_set_load(header, 0x81dfffc0);
+	image_set_ep(header, 0x81dfffc0);
+	image_set_os(header, IH_OS_LINUX);
+	image_set_arch(header, IH_ARCH_ARM64);
+	image_set_type(header, IH_TYPE_KERNEL);
+	image_set_comp(header, IH_COMP_NONE);
+	image_set_dcrc(header, crc32(0, arm64, size + 64));
+	image_set_hcrc(header, crc32(0, (void *)header, sizeof(*header)));
+	/* The optional persistent bootcmd hook consumes/clears this RAM guard.
+	 * No flash environment is edited by this function.
+	 */
+	*(volatile u32 *)0x80200000 = 0x5642534b;
+	*(volatile u32 *)0x80200004 = 0xa9bdacb4;
+	free(compressed);
+	printf("Returning to hash-verified original U-Boot through Linux handoff\n");
+	return run_commandf("bootm 0x81dfff80 - %lx", (ulong)gd->fdt_blob);
+out:
+	free(compressed);
+	return ret;
+}
diff --git a/board/airoha/an7583/vb235v-map.c b/board/airoha/an7583/vb235v-map.c
new file mode 100644
index 00000000..21e2959e
--- /dev/null
+++ b/board/airoha/an7583/vb235v-map.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded decoder for the observed VB235v factory BBT/BMT-v1 format.
+ * No reconstruction, repair, bad-block marking or flash writes occur here.
+ */
+#include <linux/errno.h>
+#include <string.h>
+#include "vb235v-map.h"
+
+static u16 le16(const u8 *p)
+{
+	return p[0] | ((u16)p[1] << 8);
+}
+
+int vb_decode_bbt(struct vb_map *m, const u8 *p, size_t n)
+{
+	u16 sum;
+	unsigned int i;
+
+	if (!m || !p || n < 512 || memcmp(p, "RAWB", 4) || p[8] != 1 || p[9] > 250)
+		return -EINVAL;
+	sum = p[8] + p[9];
+	for (i = 12; i < 512; i++)
+		sum += p[i];
+	if (p[4] != (sum & 255) || p[5] != (sum >> 8) || p[6] || p[7])
+		return -EBADMSG;
+	for (i = 0; i < p[9]; i++) {
+		u16 value = le16(p + 12 + 2 * i);
+
+		if (value >= VB_BLOCKS - VB_POOL || (i && value <= le16(p + 10 + 2 * i)))
+			return -EINVAL;
+	}
+	m->initial_count = p[9];
+	for (i = 0; i < p[9]; i++)
+		m->initial_bad[i] = le16(p + 12 + 2 * i);
+	return 0;
+}
+
+int vb_decode_bmt(struct vb_map *m, const u8 *p, size_t n)
+{
+	unsigned int i, j;
+	u8 sum;
+
+	if (!m || !p || n < 20 + VB_POOL * 4 || memcmp(p, "BMT", 3) ||
+	    p[3] != 1 || p[5] > VB_POOL)
+		return -EINVAL;
+	sum = p[3] + p[5];
+	for (i = 20; i < 20 + VB_POOL * 4; i++)
+		sum += p[i];
+	if (sum != p[6])
+		return -EBADMSG;
+	for (i = 0; i < p[5]; i++) {
+		u16 bad = le16(p + 20 + 4 * i);
+		u16 replacement = le16(p + 22 + 4 * i);
+
+		if (bad >= VB_BLOCKS - VB_POOL || replacement < VB_BLOCKS - VB_POOL ||
+		    replacement >= VB_BLOCKS)
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (bad == le16(p + 20 + 4 * j) || replacement == le16(p + 22 + 4 * j))
+				return -EINVAL;
+	}
+	m->mapped_count = p[5];
+	for (i = 0; i < p[5]; i++) {
+		m->bad[i] = le16(p + 20 + 4 * i);
+		m->replacement[i] = le16(p + 22 + 4 * i);
+	}
+	return 0;
+}
+
+int vb_map_finish(struct vb_map *m)
+{
+	bool used[VB_BLOCKS] = { false };
+	u16 i, j, physical;
+
+	if (!m)
+		return -EINVAL;
+	m->valid = false;
+	if (m->bbt_block < VB_BLOCKS - VB_POOL || m->bbt_block >= VB_BLOCKS ||
+	    m->bmt_block < VB_BLOCKS - VB_POOL || m->bmt_block >= VB_BLOCKS ||
+	    m->bmt_block == m->bbt_block || m->initial_count > 250 || m->mapped_count > VB_POOL)
+		return -EINVAL;
+	for (i = 0; i < m->mapped_count; i++) {
+		if (m->replacement[i] == m->bmt_block || m->replacement[i] == m->bbt_block)
+			return -EINVAL;
+		for (j = 0; j < m->initial_count; j++)
+			if (m->bad[i] == m->initial_bad[j])
+				return -EINVAL;
+	}
+	m->logical_blocks = VB_BLOCKS - VB_POOL - m->initial_count;
+	for (i = 0; i < m->logical_blocks; i++) {
+		physical = i;
+		for (j = 0; j < m->initial_count; j++)
+			if (physical >= m->initial_bad[j])
+				physical++;
+		for (j = 0; j < m->mapped_count; j++)
+			if (physical == m->bad[j]) {
+				physical = m->replacement[j];
+				break;
+			}
+		if (physical >= VB_BLOCKS || used[physical])
+			return -EINVAL;
+		used[physical] = true;
+		m->physical[i] = physical;
+	}
+	m->valid = true;
+	return 0;
+}
+
+int vb_map_load(struct vb_map *m, vb_read_page read_page, void *context)
+{
+	u8 page[VB_PAGE];
+	int block;
+	bool found_bbt = false, found_bmt = false;
+
+	if (!m || !read_page)
+		return -EINVAL;
+	memset(m, 0, sizeof(*m));
+	/* Factory BBT chooses the first valid record from the pool start. */
+	for (block = VB_BLOCKS - VB_POOL; block < VB_BLOCKS; block++) {
+		if (read_page(context, block, page))
+			continue;
+		if (!vb_decode_bbt(m, page, sizeof(page))) {
+			m->bbt_block = block;
+			found_bbt = true;
+			break;
+		}
+	}
+	/* Factory BMT chooses the first valid record from the pool end. */
+	for (block = VB_BLOCKS - 1; block >= VB_BLOCKS - VB_POOL; block--) {
+		if (read_page(context, block, page))
+			continue;
+		if (!vb_decode_bmt(m, page, sizeof(page))) {
+			m->bmt_block = block;
+			found_bmt = true;
+			break;
+		}
+	}
+	if (!found_bbt || !found_bmt)
+		return -ENOENT;
+	return vb_map_finish(m);
+}
+
+int vb_translate(const struct vb_map *m, u32 logical, u32 *physical)
+{
+	u32 block = logical / VB_ERASE;
+
+	if (!m || !physical || !m->valid || logical >= VB_LIMIT || block >= m->logical_blocks)
+		return -EINVAL;
+	*physical = (u32)m->physical[block] * VB_ERASE + logical % VB_ERASE;
+	return 0;
+}
diff --git a/board/airoha/an7583/vb235v-map.h b/board/airoha/an7583/vb235v-map.h
new file mode 100644
index 00000000..c212fc66
--- /dev/null
+++ b/board/airoha/an7583/vb235v-map.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VB235V_MAP_H
+#define VB235V_MAP_H
+#include <linux/types.h>
+#define VB_BLOCKS 2048
+#define VB_POOL 163
+#define VB_PAGE 4096
+#define VB_ERASE 0x40000
+#define VB_LIMIT 0xc680000
+struct vb_map {
+	u16 physical[VB_BLOCKS];
+	u16 initial_bad[250];
+	u16 bad[250], replacement[250];
+	u16 bbt_block, bmt_block, logical_blocks;
+	u8 initial_count, mapped_count;
+	bool valid;
+};
+typedef int (*vb_read_page)(void *context, u16 block, u8 *page);
+int vb_decode_bbt(struct vb_map *map, const u8 *page, size_t length);
+int vb_decode_bmt(struct vb_map *map, const u8 *page, size_t length);
+int vb_map_finish(struct vb_map *map);
+int vb_map_load(struct vb_map *map, vb_read_page read_page, void *context);
+int vb_translate(const struct vb_map *map, u32 logical, u32 *physical);
+#endif
diff --git a/board/airoha/an7583/vb235v-storage.c b/board/airoha/an7583/vb235v-storage.c
new file mode 100644
index 00000000..337c1ca9
--- /dev/null
+++ b/board/airoha/an7583/vb235v-storage.c
@@ -0,0 +1,527 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <asm/global_data.h>
+#include <command.h>
+#include <env.h>
+#include <image.h>
+#include <malloc.h>
+#include <mtd.h>
+#include <linux/err.h>
+#include <linux/libfdt.h>
+#include <linux/mtd/mtd.h>
+#include <u-boot/sha256.h>
+#include <u-boot/crc.h>
+#include <vb235v-recovery.h>
+#include "vb235v-map.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+static struct mtd_info *flash;
+static struct vb_map mapping;
+static bool anchors_verified, attempted;
+static int cached_active = -99;
+static u32 cached_sequence;
+#ifndef VB_SLOT_SCRATCH
+#define VB_SLOT_SCRATCH 0x95000000UL
+#endif
+static const char *storage_state = "not initialized";
+static const struct vb_target targets[] = {
+	{ "bootloader", 0, 0xc0000, false },
+	{ "art", 0xc0000, 0x380000, false },
+	{ "misc", 0x440000, 0x800000, false },
+	{ "slot0", 0xc40000, 0x5000000, false },
+	{ "slot1", 0x5c40000, 0x5000000, false },
+	{ "reserve", 0xb840000, 0x40000, false },
+	{ "whole-logical", 0, VB_LIMIT, false },
+	{ "nand-raw-main-oob", 0, 2048U * 64U * (4096U + 256U), true },
+};
+
+static int physical_read(u32 address, void *data, size_t length)
+{
+	size_t done;
+	int ret = mtd_read(flash, address, length, &done, data);
+
+	if (ret && !mtd_is_bitflip(ret))
+		return ret;
+	return done == length ? 0 : -EIO;
+}
+
+static int table_page(void *context, u16 block, u8 *page)
+{
+	u8 oob[256];
+	struct mtd_oob_ops ops = { .mode = MTD_OPS_PLACE_OOB,
+		.ooblen = sizeof(oob), .oobbuf = oob };
+	int ret;
+
+	ret = mtd_read_oob(flash, (u32)block * VB_ERASE, &ops);
+	if ((ret && !mtd_is_bitflip(ret)) || ops.oobretlen != sizeof(oob))
+		return -EIO;
+	/* Vendor Flash-ECC path retains physical OOB positions. Byte 0
+	 * marks initial bad blocks; byte 1 marks later failed blocks.
+	 * The first-page markers are inspected without changing them.
+	 */
+	if (oob[0] != 0xff || oob[1] != 0xff)
+		return -EIO;
+	return physical_read((u32)block * VB_ERASE, page, VB_PAGE);
+}
+
+const struct vb_target *vb_target_find(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(targets); i++)
+		if (!strcmp(name, targets[i].name))
+			return &targets[i];
+	return NULL;
+}
+
+static int mapped_read(u32 address, void *data, size_t length)
+{
+	u8 *out = data;
+	int ret;
+	u32 physical;
+	size_t count;
+
+	if (address >= VB_LIMIT || length > VB_LIMIT - address)
+		return -EINVAL;
+	while (length) {
+		ret = vb_translate(&mapping, address, &physical);
+		if (ret)
+			return ret;
+		count = min_t(size_t, length, VB_ERASE - address % VB_ERASE);
+		ret = physical_read(physical, out, count);
+		if (ret)
+			return ret;
+		out += count;
+		address += count;
+		length -= count;
+	}
+	return 0;
+}
+
+static int anchor_hash(u32 address, u32 length, const char *expected)
+{
+	u8 *buffer, hash[32];
+	sha256_context ctx;
+	char hex[65];
+	u32 count;
+	int ret = 0, i;
+
+	buffer = malloc(65536);
+	if (!buffer)
+		return -ENOMEM;
+	sha256_starts(&ctx);
+	while (length) {
+		count = min(length, 65536U);
+		ret = mapped_read(address, buffer, count);
+		if (ret)
+			break;
+		sha256_update(&ctx, buffer, count);
+		address += count;
+		length -= count;
+	}
+	free(buffer);
+	if (ret)
+		return ret;
+	sha256_finish(&ctx, hash);
+	for (i = 0; i < 32; i++)
+		sprintf(hex + 2 * i, "%02x", hash[i]);
+	return strcmp(hex, expected) ? -EBADMSG : 0;
+}
+
+int vb_storage_init(void)
+{
+	struct mtd_info *mtd;
+	int ret;
+
+	if (attempted)
+		return mapping.valid ? 0 : -ENODEV;
+	attempted = true;
+	mtd_probe_devices();
+	mtd_for_each_device(mtd) {
+		if (!mtd_is_partition(mtd) && mtd->size == 0x20000000 &&
+		    mtd->erasesize == VB_ERASE && mtd->writesize == VB_PAGE &&
+		    mtd->oobsize == 256) {
+			flash = mtd;
+			break;
+		}
+	}
+	if (!flash) {
+		storage_state = "NAND geometry not matched";
+		return -ENODEV;
+	}
+	ret = vb_map_load(&mapping, table_page, NULL);
+	if (ret) {
+		storage_state = "factory BBT/BMT unavailable; raw backup only";
+		return ret;
+	}
+	/* These hashes derive from this board's verified private backup. */
+	anchors_verified = !anchor_hash(0xc0000, 0x380000,
+		"b0fbd6ca59927d190aea300734d8aceb41309ee591d3a37d003bf8f3e16a1aa3") &&
+		!anchor_hash(0x2f800, 310799,
+		"b4daaf52ff8224cd8b577f72d769adb12823d536e2408d77919e6c9940fc388b");
+	storage_state = anchors_verified ? "factory map and board anchors verified" :
+		"factory map loaded; board anchors differ; install disabled";
+	return 0;
+}
+
+const char *vb_storage_status(void)
+{
+	return storage_state;
+}
+
+int vb_storage_read(const struct vb_target *t, u32 offset, void *data, size_t length)
+{
+	u8 raw[VB_PAGE + 256];
+	u32 page, within;
+	size_t count;
+	u8 *out = data;
+	int ret;
+	struct mtd_oob_ops ops;
+
+	if (!t || !data || offset > t->size || length > t->size - offset)
+		return -EINVAL;
+	ret = vb_storage_init();
+	if (!t->physical_raw && ret)
+		return ret;
+	if (!flash)
+		return -ENODEV;
+	if (!t->physical_raw)
+		return mapped_read(t->offset + offset, data, length);
+	while (length) {
+		page = offset / sizeof(raw);
+		within = offset % sizeof(raw);
+		memset(&ops, 0, sizeof(ops));
+		ops.mode = MTD_OPS_RAW;
+		ops.len = VB_PAGE;
+		ops.ooblen = 256;
+		ops.datbuf = raw;
+		ops.oobbuf = raw + VB_PAGE;
+		ret = mtd_read_oob(flash, page * VB_PAGE, &ops);
+		if (ret || ops.retlen != VB_PAGE || ops.oobretlen != 256)
+			return ret ? ret : -EIO;
+		count = min_t(size_t, length, sizeof(raw) - within);
+		memcpy(out, raw + within, count);
+		out += count;
+		offset += count;
+		length -= count;
+	}
+	return 0;
+}
+
+static bool single_string(const char *text, int length)
+{
+	return text && length > 1 && text[length - 1] == '\0' &&
+		strlen(text) == length - 1 && !strchr(text, '/');
+}
+
+static int validate_board_dtb(const void *data, size_t length)
+{
+	void *aligned;
+	int ret;
+
+	if (length < 40 || length > 0x100000)
+		return -EINVAL;
+	aligned = malloc(length);
+	if (!aligned)
+		return -ENOMEM;
+	memcpy(aligned, data, length);
+	ret = fdt_check_full(aligned, length);
+	if (!ret)
+		ret = fdt_node_check_compatible(aligned, 0, "tplink,vb235v");
+	free(aligned);
+	return ret ? -EXDEV : 0;
+}
+
+int vb_fit_validate(const void *image, size_t length)
+{
+	int images, configs, conf, node, hash_node, len, count = 0;
+	const char *name, *type, *arch, *algo;
+	const void *data, *value;
+	u8 hash[32];
+	const char *references[] = { "kernel", "fdt", "ramdisk" };
+	unsigned int i;
+
+	if (!image || length < 40 || length > 0x5000000 || fdt_check_full(image, length))
+		return -EINVAL;
+	if (fdt_totalsize(image) != length)
+		return -EINVAL;
+	images = fdt_path_offset(image, "/images");
+	configs = fdt_path_offset(image, "/configurations");
+	if (images < 0 || configs < 0)
+		return -EINVAL;
+	name = fdt_getprop(image, configs, "default", &len);
+	if (!single_string(name, len))
+		return -EINVAL;
+	conf = fdt_subnode_offset(image, configs, name);
+	if (conf < 0 || fdt_node_check_compatible(image, conf, "tplink,vb235v") ||
+	    fdt_getprop(image, conf, "vb235v,recovery-core", NULL))
+		return -EXDEV;
+	value = fdt_getprop(image, conf, "vb235v,firmware-image", &len);
+	if (!value || len != 4 || fdt32_to_cpu(*(const fdt32_t *)value) != 1)
+		return -EINVAL;
+	value = fdt_getprop(image, conf, "vb235v,sequence", &len);
+	if (!value || len != 4 || !fdt32_to_cpu(*(const fdt32_t *)value))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(references); i++) {
+		name = fdt_getprop(image, conf, references[i], &len);
+		if (!name && i == 2)
+			continue;
+		if (!single_string(name, len))
+			return -EINVAL;
+		node = fdt_subnode_offset(image, images, name);
+		type = fdt_getprop(image, node, "type", &len);
+		if (!single_string(type, len) || strcmp(type, i == 1 ? "flat_dt" : references[i]))
+			return -EINVAL;
+		arch = fdt_getprop(image, node, "arch", &len);
+		if (!single_string(arch, len) || strcmp(arch, "arm64"))
+			return -EINVAL;
+		algo = fdt_getprop(image, node, "compression", &len);
+		if (!single_string(algo, len) ||
+		    (strcmp(algo, "none") && (i == 1 || (strcmp(algo, "gzip") && strcmp(algo, "lzma")))))
+			return -EINVAL;
+		if (i == 0) {
+			algo = fdt_getprop(image, node, "os", &len);
+			if (!single_string(algo, len) || strcmp(algo, "linux"))
+				return -EINVAL;
+		}
+		data = fdt_getprop(image, node, "data", &len);
+		if (!data || len <= 0)
+			return -EINVAL;
+		if (i == 1 && validate_board_dtb(data, len))
+			return -EXDEV;
+		sha256_csum_wd(data, len, hash, CHUNKSZ_SHA256);
+		hash_node = fdt_first_subnode(image, node);
+		if (hash_node < 0 || strncmp(fdt_get_name(image, hash_node, NULL), "hash", 4) ||
+		    fdt_next_subnode(image, hash_node) >= 0)
+			return -EINVAL;
+		algo = fdt_getprop(image, hash_node, "algo", &len);
+		if (!single_string(algo, len) || strcmp(algo, "sha256"))
+			return -EINVAL;
+		value = fdt_getprop(image, hash_node, "value", &len);
+		if (!value || len != 32 || memcmp(value, hash, 32))
+			return -EBADMSG;
+		count++;
+	}
+	fdt_for_each_subnode(node, image, images)
+		count--;
+	return count ? -EINVAL : 0;
+}
+
+static int factory_slot(void)
+{
+	u8 flag[8], checksum = 0;
+	unsigned int i;
+	int ret = vb_storage_read(vb_target_find("reserve"), 0, flag, sizeof(flag));
+
+	if (ret)
+		return ret;
+	for (i = 0; i < 7; i++)
+		checksum += flag[i];
+	/* The format is checked, rather than defaulting unknown data to slot 0. */
+	if (checksum != flag[7])
+		return -EBADMSG;
+	for (i = 0; i < 6; i++)
+		if (flag[i] > 1)
+			return -EINVAL;
+	return flag[4] && flag[5] ? 1 : 0;
+}
+
+static u32 fit_sequence(const void *image)
+{
+	int configs = fdt_path_offset(image, "/configurations");
+	const char *name = fdt_getprop(image, configs, "default", NULL);
+	int conf = fdt_subnode_offset(image, configs, name);
+	const fdt32_t *value = fdt_getprop(image, conf, "vb235v,sequence", NULL);
+
+	return fdt32_to_cpu(*value);
+}
+
+int vb_active_slot(void)
+{
+	const struct vb_target *target;
+	u8 *image = (void *)VB_SLOT_SCRATCH;
+	u32 length, sequence;
+	int slot, selected, ret;
+
+	if (cached_active != -99)
+		return cached_active;
+	ret = vb_storage_init();
+	if (ret)
+		return ret;
+	if (gd->start_addr_sp < VB_SLOT_SCRATCH + 0x5000000)
+		return -ENOMEM;
+	selected = factory_slot();
+	cached_sequence = 0;
+	for (slot = 0; slot < 2; slot++) {
+		target = vb_target_find(slot ? "slot1" : "slot0");
+		if (mapped_read(target->offset, image, VB_PAGE) || fdt_check_header(image))
+			continue;
+		length = fdt_totalsize(image);
+		if (length < 40 || length > target->size ||
+		    mapped_read(target->offset, image, length) || vb_fit_validate(image, length))
+			continue;
+		sequence = fit_sequence(image);
+		if (sequence > cached_sequence) {
+			selected = slot;
+			cached_sequence = sequence;
+		}
+	}
+	cached_active = selected;
+	return selected;
+}
+
+int vb_storage_install(unsigned int slot, const void *image, size_t length,
+		       const char *expected)
+{
+	const struct vb_target *target;
+	u32 address, physical, page, count;
+	u16 metadata_index;
+	u8 metadata[2];
+	struct mtd_oob_ops ops;
+	u8 hash[32], verify[VB_PAGE], padded[VB_PAGE];
+	char hex[65];
+	int i, ret, active;
+	struct erase_info erase;
+
+	if (slot > 1 || !expected || strlen(expected) != 64)
+		return -EINVAL;
+	ret = vb_storage_init();
+	if (ret || !anchors_verified)
+		return ret ? ret : -EXDEV;
+	active = vb_active_slot();
+	if (active < 0 || active == slot)
+		return active < 0 ? active : -EPERM;
+	ret = vb_fit_validate(image, length);
+	if (ret)
+		return ret;
+	if (fit_sequence(image) <= cached_sequence)
+		return -ERANGE;
+	sha256_csum_wd(image, length, hash, CHUNKSZ_SHA256);
+	for (i = 0; i < 32; i++)
+		sprintf(hex + 2 * i, "%02x", hash[i]);
+	if (strcmp(hex, expected))
+		return -EBADMSG;
+	target = vb_target_find(slot ? "slot1" : "slot0");
+	/* Only the inactive firmware partition is writable through this API.
+	 * Boot stages, ART, misc, selector and mapping tables stay untouched.
+	 */
+	for (address = 0; address < length; address += VB_ERASE) {
+		ret = vb_translate(&mapping, target->offset + address, &physical);
+		if (ret)
+			return ret;
+		memset(&erase, 0, sizeof(erase));
+		erase.addr = physical;
+		erase.len = VB_ERASE;
+		ret = mtd_erase(flash, &erase);
+		if (ret)
+			return ret;
+		for (page = 0; page < VB_ERASE && address + page < length; page += VB_PAGE) {
+			count = min_t(u32, VB_PAGE, length - address - page);
+			memset(padded, 0xff, sizeof(padded));
+			memcpy(padded, (const u8 *)image + address + page, count);
+			metadata_index = physical / VB_ERASE;
+			for (i = 0; i < mapping.mapped_count; i++)
+				if (mapping.replacement[i] == metadata_index) {
+					metadata_index = mapping.bad[i];
+					break;
+				}
+			metadata[0] = metadata_index & 255;
+			metadata[1] = metadata_index >> 8;
+			memset(&ops, 0, sizeof(ops));
+			ops.mode = MTD_OPS_PLACE_OOB;
+			ops.len = VB_PAGE;
+			ops.datbuf = padded;
+			ops.ooboffs = 2;
+			ops.ooblen = sizeof(metadata);
+			ops.oobbuf = metadata;
+			ret = mtd_write_oob(flash, physical + page, &ops);
+			if (ret || ops.retlen != VB_PAGE || ops.oobretlen != sizeof(metadata))
+				return ret ? ret : -EIO;
+			ret = physical_read(physical + page, verify, VB_PAGE);
+			if (ret || memcmp(padded, verify, VB_PAGE))
+				return ret ? ret : -EIO;
+		}
+	}
+	ret = anchor_hash(target->offset, length, expected);
+	if (!ret) {
+		cached_active = slot;
+		cached_sequence = fit_sequence(image);
+	}
+	return ret;
+}
+
+int vb_boot(void)
+{
+	u8 *image;
+	int active, slot, attempt, ret;
+	u32 length;
+	const struct vb_target *target;
+
+	active = vb_active_slot();
+	if (active < 0)
+		active = 0;
+	for (attempt = 0; attempt < 2; attempt++) {
+		slot = active ^ attempt;
+		target = vb_target_find(slot ? "slot1" : "slot0");
+		image = (void *)0x90000000;
+		ret = vb_storage_read(target, 0, image, VB_PAGE);
+		if (ret || fdt_check_header(image))
+			continue;
+		length = fdt_totalsize(image);
+		if (length < 40 || length > target->size)
+			continue;
+		ret = vb_storage_read(target, 0, image, length);
+		if (ret || vb_fit_validate(image, length))
+			continue;
+		printf("Booting verified FIT in slot %d\n", slot);
+		ret = run_command("bootm 0x90000000", 0);
+		if (!ret)
+			return 0;
+	}
+	return vb_factory_boot();
+}
+
+static int do_vb(struct cmd_tbl *cmd, int flag, int argc, char *const argv[])
+{
+	const struct vb_target *target;
+	u32 length;
+	ulong address;
+	int ret;
+
+	if (argc < 2)
+		return CMD_RET_USAGE;
+	if (!strcmp(argv[1], "recover") && argc == 2) {
+		ret = vb_httpd_window();
+	} else if (!strcmp(argv[1], "info") && argc == 2) {
+		ret = vb_storage_init();
+		printf("%s; active slot %d\n", vb_storage_status(), vb_active_slot());
+	} else if (!strcmp(argv[1], "backup") && argc == 4) {
+		target = vb_target_find(argv[2]);
+		address = hextoul(argv[3], NULL);
+		if (!target || target->physical_raw || target->size > 0x5000000 ||
+		    address != 0x90000000)
+			return CMD_RET_USAGE;
+		ret = vb_storage_read(target, 0, (void *)address, target->size);
+		if (!ret) {
+			env_set_hex("fileaddr", address);
+			env_set_hex("filesize", target->size);
+		}
+	} else if (!strcmp(argv[1], "install") && argc == 6) {
+		address = hextoul(argv[3], NULL);
+		length = hextoul(argv[4], NULL);
+		if (address != 0x90000000 || length > 0x5000000 ||
+		    (strcmp(argv[2], "0") && strcmp(argv[2], "1")))
+			return CMD_RET_USAGE;
+		ret = vb_storage_install(argv[2][0] - '0', (void *)address, length, argv[5]);
+	} else if (!strcmp(argv[1], "boot") && argc == 2) {
+		ret = vb_boot();
+	} else {
+		return CMD_RET_USAGE;
+	}
+	printf("VB235v result: %d\n", ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(vb, 6, 0, do_vb, "VB235v mapped storage and recovery",
+	"info | backup <bootloader|art|misc|slot0|slot1|reserve> 90000000\n"
+	"vb install <0|1> 90000000 <hex-size> <sha256>\n"
+	"vb boot");
