+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Experimental integrated-switch LAN candidate. Never use as a flash image. */
+/dts-v1/;
+#include "an7583.dtsi"
+
+/ {
+	model = "TP-Link VB235v RAM LAN recovery candidate";
+	compatible = "tplink,vb235v-ram-development", "airoha,an7583";
+	aliases { serial0 = &uart1; ethernet0 = &gdm1; };
+	chosen {
+		stdout-path = "serial0:115200n8";
+		u-boot,usable-memory-range = <0 0x80200000 0 0x1fe00000>;
+	};
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x20000000>;
+	};
+	/delete-node/ reserved-memory;
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		atf@80000000 { reg = <0 0x80000000 0 0x200000>; no-map; };
+		npu@84000000 { reg = <0 0x84000000 0 0x100000>; no-map; };
+		logs@8b000000 { reg = <0 0x8b000000 0 0x200000>; no-map; };
+	};
+};
+
+&gdm1 { status = "okay"; };
+&gdm2 { status = "disabled"; };
+&gdm3 { status = "disabled"; };
+&pon_pcs { status = "disabled"; };
+&eth_pcs { status = "disabled"; };
+&snfi { status = "disabled"; };
+&mmc0 { status = "disabled"; };
+
+&eth {
+	#address-cells = <1>;
+	#size-cells = <0>;
+};
+
+&{/soc/system-controller@1fb00000} {
+	#address-cells = <1>;
+	#size-cells = <0>;
+};
