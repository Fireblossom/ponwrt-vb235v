#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=95
STOP=10
USE_PROCD=1
STATE=/etc/ponwrt/management-m83.json
KEY=/etc/dropbear/dropbear_ed25519_host_key

start_service() {
    [ -f "$STATE" ] && grep -Fq '"state":"configured"' "$STATE" || return 0
    [ -s "$KEY" ] && [ ! -L "$KEY" ] || return 0
    ip -4 addr show dev br-lan 2>/dev/null |
        grep -Eq 'inet 169\.254\.235\.1/16([[:space:]]|$)' || return 0
    procd_open_instance
    # A literal address never degrades to a wildcard when the interface is down.
    procd_set_param command /usr/sbin/dropbear -F -P /var/run/ponwrt-recovery-ssh-m83.pid \
        -p 169.254.235.1:22 -s -g -j -k -r "$KEY" -K 300 -T 3
    procd_set_param respawn 60 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_interface_trigger 'interface.*' ponwrt_recovery /etc/init.d/ponwrt-recovery-ssh-m83 restart
}
