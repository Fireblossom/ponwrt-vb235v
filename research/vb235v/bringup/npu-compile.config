# Compile-only configuration; this does not generate a boot/upgrade image.
CONFIG_EXPERT=y
CONFIG_OF=y
CONFIG_ARCH_AIROHA=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AIROHA=y
CONFIG_NET_AIROHA=y
CONFIG_NET_AIROHA_NPU=y
CONFIG_NET_SWITCHDEV=y
CONFIG_FW_LOADER=y
CONFIG_NVMEM=y
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_PCS_AIROHA=y
CONFIG_DEBUG_FS=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MODULES=n
CONFIG_LOCALVERSION="-vb235v-npu-compile-dev"
CONFIG_LOCALVERSION_AUTO=n
