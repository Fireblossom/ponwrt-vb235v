+/* Shared by the protected FIT installer and opt-in physical-path test. */
+static int erase_mapped_block(u32 logical, u32 *physical)
+{
+	struct erase_info erase;
+	int ret;
+
+	if (logical % VB_ERASE)
+		return -EINVAL;
+	ret = vb_translate(&mapping, logical, physical);
+	if (ret)
+		return ret;
+	memset(&erase, 0, sizeof(erase));
+	erase.addr = *physical;
+	erase.len = VB_ERASE;
+	return mtd_erase(flash, &erase);
+}
+
+static int program_physical_page(u32 physical, const u8 data[VB_PAGE])
+{
+	struct mtd_oob_ops ops;
+	u16 metadata_index = physical / VB_ERASE;
+	u8 metadata[2], verify[VB_PAGE];
+	int i, ret;
+
+	if (physical % VB_PAGE)
+		return -EINVAL;
+	for (i = 0; i < mapping.mapped_count; i++)
+		if (mapping.replacement[i] == metadata_index) {
+			metadata_index = mapping.bad[i];
+			break;
+		}
+	metadata[0] = metadata_index & 255;
+	metadata[1] = metadata_index >> 8;
+	memset(&ops, 0, sizeof(ops));
+	ops.mode = MTD_OPS_PLACE_OOB;
+	ops.len = VB_PAGE;
+	ops.datbuf = (u8 *)data;
+	ops.ooboffs = 2;
+	ops.ooblen = sizeof(metadata);
+	ops.oobbuf = metadata;
+	ret = mtd_write_oob(flash, physical, &ops);
+	if (ret || ops.retlen != VB_PAGE || ops.oobretlen != sizeof(metadata))
+		return ret ? ret : -EIO;
+	ret = physical_read(physical, verify, VB_PAGE);
+	if (ret || memcmp(data, verify, VB_PAGE))
+		return ret ? ret : -EIO;
+	return 0;
+}
