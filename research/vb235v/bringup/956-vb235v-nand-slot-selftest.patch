+#ifdef CONFIG_VB235V_NAND_SELFTEST
+/* This opt-in command has one fixed address, requires both full-slot hashes,
+ * an inactive slot 1, identity mapping and entirely erased main AND raw OOB.
+ * It never creates a bootable FIT or changes the slot's first block.
+ */
+#define VB_TEST_LOGICAL 0x0ac00000U
+static bool bytes_ff(const u8 *data, size_t length)
+{
+	size_t i;
+
+	for (i = 0; i < length; i++)
+		if (data[i] != 0xff)
+			return false;
+	return true;
+}
+
+static int test_raw_erased(u32 physical, u8 *buffer)
+{
+	struct mtd_oob_ops ops;
+	u32 page;
+	int ret;
+
+	for (page = 0; page < VB_ERASE; page += VB_PAGE) {
+		memset(&ops, 0, sizeof(ops));
+		ops.mode = MTD_OPS_RAW;
+		ops.len = VB_PAGE;
+		ops.ooblen = 256;
+		ops.datbuf = buffer;
+		ops.oobbuf = buffer + VB_PAGE;
+		ret = mtd_read_oob(flash, physical + page, &ops);
+		if (ret || ops.retlen != VB_PAGE || ops.oobretlen != 256 ||
+		    !bytes_ff(buffer, VB_PAGE + 256))
+			return ret ? ret : -EBADMSG;
+	}
+	return 0;
+}
+
+static void test_pattern(u8 *buffer, u32 page)
+{
+	u32 state = 0x75832300U ^ page;
+	unsigned int i;
+
+	for (i = 0; i < VB_PAGE; i++) {
+		state ^= state << 13;
+		state ^= state >> 17;
+		state ^= state << 5;
+		buffer[i] = state >> 24;
+	}
+}
+
+static int test_protected_hashes(u8 hashes[4][32])
+{
+	const char *names[] = { "bootloader", "art", "misc", "reserve" };
+	const struct vb_target *target;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		target = vb_target_find(names[i]);
+		ret = mapped_sha256(target->offset, target->size, hashes[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int vb_storage_nand_selftest(const char *secondary_sha, const char *active_sha)
+{
+	u8 before[4][32], after[4][32], *buffer;
+	struct mtd_oob_ops ops;
+	u32 physical, page, restored;
+	int ret, cleanup, active;
+
+	if (!secondary_sha || !active_sha || strlen(secondary_sha) != 64 ||
+	    strlen(active_sha) != 64)
+		return -EINVAL;
+	ret = vb_storage_init();
+	if (ret || !anchors_verified)
+		return ret ? ret : -EXDEV;
+	cached_active = -99;
+	active = vb_active_slot();
+	if (active != 0)
+		return active < 0 ? active : -EPERM;
+	ret = vb_translate(&mapping, VB_TEST_LOGICAL, &physical);
+	if (ret || physical != VB_TEST_LOGICAL)
+		return ret ? ret : -EXDEV;
+	ret = anchor_hash(0x5c40000, 0x5000000, secondary_sha);
+	if (!ret)
+		ret = anchor_hash(0xc40000, 0x5000000, active_sha);
+	if (ret)
+		return ret;
+	buffer = malloc(VB_PAGE + 256);
+	if (!buffer)
+		return -ENOMEM;
+	ret = test_raw_erased(physical, buffer);
+	if (ret)
+		goto out;
+	ret = test_protected_hashes(before);
+	if (ret)
+		goto out;
+	printf("NAND selftest: ONLY inactive slot1 tail logical/physical %08x, size %x\n",
+	       physical, VB_ERASE);
+	ret = erase_mapped_block(VB_TEST_LOGICAL, &physical);
+	if (ret)
+		goto restore;
+	for (page = 0; page < VB_ERASE; page += VB_PAGE) {
+		test_pattern(buffer, page / VB_PAGE);
+		ret = program_physical_page(physical + page, buffer);
+		if (ret)
+			goto restore;
+	}
+	ret = anchor_hash(VB_TEST_LOGICAL, VB_ERASE, "65d76b0895a4a418d453d43f7666f97721c3eaf3c2c620c72345146cb41dcdf6");
+	if (ret)
+		goto restore;
+	for (page = 0; page < VB_ERASE; page += VB_PAGE) {
+		memset(&ops, 0, sizeof(ops));
+		ops.mode = MTD_OPS_PLACE_OOB;
+		ops.ooblen = 256;
+		ops.oobbuf = buffer;
+		ret = mtd_read_oob(flash, physical + page, &ops);
+		if ((ret && !mtd_is_bitflip(ret)) || ops.oobretlen != 256 ||
+		    buffer[0] != 0xff || buffer[1] != 0xff ||
+		    buffer[2] != (physical / VB_ERASE & 255) ||
+		    buffer[3] != (physical / VB_ERASE >> 8)) {
+			ret = -EIO;
+			goto restore;
+		}
+		ret = 0;
+	}
+	printf("NAND selftest: 64 ECC-enabled pages and OOB indices verified; pattern SHA 65d76b0895a4a418d453d43f7666f97721c3eaf3c2c620c72345146cb41dcdf6\n");
+restore:
+	/* Always attempt restoration before returning a programming/readback error. */
+	cleanup = erase_mapped_block(VB_TEST_LOGICAL, &restored);
+	if (!cleanup && restored != physical)
+		cleanup = -EXDEV;
+	if (!cleanup)
+		cleanup = test_raw_erased(physical, buffer);
+	if (cleanup) {
+		printf("NAND selftest: RESTORE FAILED (%d), original result %d\n", cleanup, ret);
+		ret = cleanup;
+		goto out;
+	}
+	printf("NAND selftest: restored entire main+OOB to erased FF\n");
+	cleanup = anchor_hash(0x5c40000, 0x5000000, secondary_sha);
+	if (!cleanup)
+		cleanup = anchor_hash(0xc40000, 0x5000000, active_sha);
+	if (!cleanup)
+		cleanup = test_protected_hashes(after);
+	if (!cleanup && memcmp(before, after, sizeof(before)))
+		cleanup = -EBADMSG;
+	if (cleanup)
+		ret = cleanup;
+	if (!ret)
+		printf("NAND selftest: both full slots and boot/ART/misc/selector unchanged\n");
+out:
+	free(buffer);
+	return ret;
+}
+#endif
