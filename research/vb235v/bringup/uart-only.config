# SPDX-License-Identifier: GPL-2.0-only
# Merge onto arm64 allnoconfig, then run olddefconfig and audit the result.
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_OF=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_GENERIC_IRQ_DEBUGFS=n
# ARM64 selects SMP; only CPU0 is described in the development DT.
CONFIG_NR_CPUS=2
CONFIG_MODULES=n
CONFIG_EFI=n
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_MTD=n
CONFIG_NVMEM=n
CONFIG_BLOCK=n
CONFIG_SPI=n
CONFIG_I2C=n
CONFIG_GPIOLIB=n
CONFIG_LEDS_CLASS=n
CONFIG_NEW_LEDS=n
CONFIG_INPUT=n
CONFIG_WATCHDOG=n
# ARM64 selects the framework; the audit forbids every concrete reset driver.
CONFIG_POWER_RESET=y
CONFIG_RESET_CONTROLLER=n
CONFIG_PINCTRL=n
CONFIG_PHYLIB=n
CONFIG_GENERIC_PHY=n
CONFIG_USB_SUPPORT=n
CONFIG_MMC=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_SOUND=n
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_UNIX98_PTYS=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_PRESERVE_MTIME=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-vb235v-uart-dev"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_BUILD_SALT=""
CONFIG_DEFAULT_HOSTNAME="vb235v-uart-dev"
