  * Return: 0 or a positive number of bitflips corrected on success.
  * A negative error code otherwise.
  */
+static int spinand_vb235v_program_check(struct spinand_device *spinand,
+                                       const struct nand_page_io_req *req)
+{
+ struct nand_device *nand = spinand_to_nand(spinand);
+ u64 from = nanddev_pos_to_offs(nand, &req->pos);
+ const u8 *marker = req->oobbuf.out;
+ if (!spinand->vb235v_hybrid)
+  return 0;
+ if (req->datalen) {
+  if (req->dataoffs || req->datalen != VB_HYBRID_PAGE ||
+      req->mode == MTD_OPS_RAW || req->ooblen)
+   return -EINVAL;
+  return vb_hybrid_check(&spinand->vb235v_policy, VB_HYBRID_PROGRAM,
+                         from, req->datalen);
+ }
+ if (req->pos.page || req->mode != MTD_OPS_RAW || req->ooboffs ||
+     req->ooblen != 2 || !marker || marker[0] != 0xff || marker[1] != 0)
+  return -EINVAL;
+ return vb_hybrid_check(&spinand->vb235v_policy, VB_HYBRID_RETIRE,
+                        from, VB_HYBRID_ERASE);
+}
