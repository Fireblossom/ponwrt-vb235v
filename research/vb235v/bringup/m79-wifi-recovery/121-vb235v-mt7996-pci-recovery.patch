-						    PCI_IRQ_ALL_TYPES);
+			ret = pci_alloc_irq_vectors(hif2_dev, 1, 1, PCI_IRQ_ALL_TYPES);
 			if (ret < 0)
-				goto free_hif2;
-
-			dev->hif2->irq = hif2_dev->irq;
-			hif2_irq = dev->hif2->irq;
+				goto release;
+			dev->hif2_irq_vectors = true;
+			hif2_irq = pci_irq_vector(hif2_dev, 0);
+			hif2->irq = hif2_irq;
 		}
-
+		dev->hif2_irq = hif2_irq;
 		ret = devm_request_irq(mdev->dev, hif2_irq, mt7996_irq_handler,
-				       IRQF_SHARED, KBUILD_MODNAME "-hif",
-				       dev);
+				       IRQF_SHARED, KBUILD_MODNAME "-hif", dev);
 		if (ret)
-			goto free_hif2_wed_irq_vector;
-
+			goto release;
+		dev->hif2_irq_requested = true;
 		mt76_wr(dev, MT_INT1_MASK_CSR, 0);
-		/* master switch of PCIe tnterrupt enable */
 		mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0xff);
 	}
 
 	ret = mt7996_register_device(dev);
-	if (ret)
-		goto free_hif2_irq;
-
+	if (ret) {
+		mt7996_unregister_device(dev);
+		goto release;
