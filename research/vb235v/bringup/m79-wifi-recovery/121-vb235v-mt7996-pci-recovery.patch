 	list_for_each_entry(hif, &hif_list, list) {
+		if (hif->dev != supplier)
+			continue;
+
 		val = readl(hif->regs + MT_PCIE_RECOG_ID);
 		val &= MT_PCIE_RECOG_ID_MASK;
 		if (val != idx)
@@ -64,6 +67,8 @@
 static struct mt7996_hif *mt7996_pci_init_hif2(struct pci_dev *pdev)
 {
 	struct pci_dev *tmp_pdev;
+	struct device_link *link;
+	struct mt7996_hif *hif;
 
 	hif_idx++;
 
@@ -74,12 +79,27 @@
 		tmp_pdev = pci_get_device(PCI_VENDOR_ID_MEDIATEK, MT7990_DEVICE_ID_2, NULL);
 	if (!tmp_pdev)
 		return NULL;
-	pci_dev_put(tmp_pdev);
+	/* Establish the dependency before looking at secondary devm state. A
+	 * mere get_device() does not keep that driver's HIF/BAR resources alive.
+	 * The core waits for a CONSUMER_PROBE link before unbinding a supplier.
+	 */
+	link = device_link_add(&pdev->dev, &tmp_pdev->dev,
+			       DL_FLAG_AUTOREMOVE_CONSUMER);
+	if (!link) {
+		pci_dev_put(tmp_pdev);
+		return ERR_PTR(-ENOMEM);
+	}
+	if (READ_ONCE(link->status) != DL_STATE_CONSUMER_PROBE) {
+		pci_dev_put(tmp_pdev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
 
 	writel(hif_idx | MT_PCIE_RECOG_ID_SEM,
 	       pcim_iomap_table(pdev)[0] + MT_PCIE_RECOG_ID);
 
-	return mt7996_pci_get_hif2(hif_idx);
+	hif = mt7996_pci_get_hif2(hif_idx, &tmp_pdev->dev);
+	pci_dev_put(tmp_pdev);
+	return hif ? hif : ERR_PTR(-EPROBE_DEFER);
 }
 
