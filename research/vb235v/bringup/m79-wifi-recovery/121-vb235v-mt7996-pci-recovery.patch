+/* Also used for register_device failures; all works are initialized before it. */
 void mt7996_unregister_device(struct mt7996_dev *dev)
 {
+	bool wed_active = mtk_wed_device_active(&dev->mt76.mmio.wed);
 	int i;
 
+	WRITE_ONCE(dev->removing, true);
+	dev->recovery.hw_init_done = false;
+	cancel_work_sync(&dev->init_work);
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->wed_rro.work);
 	cancel_work_sync(&dev->reset_work);
@@ -1844,18 +1855,27 @@
 	mt7996_unregister_thermal(&dev->phy);
 	mt7996_coredump_unregister(dev);
 	mt76_unregister_device(&dev->mt76);
-	mt7996_wed_rro_free(dev);
+	if (dev->mcu_started)
+		mt7996_mcu_exit(dev);
+
+	/* MCU commands need IRQ/NAPI until exit. Stop pollers before IRQ release. */
+	mt76_worker_disable(&dev->mt76.tx_worker);
 	for (i = 0; i < ARRAY_SIZE(dev->mt76.napi); i++) {
 		if (dev->mt76.napi[i].dev)
 			napi_disable(&dev->mt76.napi[i]);
 	}
-	mt7996_mcu_exit(dev);
+	if (dev->mt76.tx_napi.dev) {
+		napi_disable(&dev->mt76.tx_napi);
+		netif_napi_del(&dev->mt76.tx_napi);
+	}
+	mt7996_pci_quiesce(dev);
+	/* Drain a producer which had passed the removing check before teardown. */
+	cancel_work_sync(&dev->dump_work);
+	cancel_work_sync(&dev->reset_work);
 	mt7996_tx_token_put(dev);
-	mt7996_dma_cleanup(dev);
-	if (mt7996_has_hwrro(dev) &&
-	    !mtk_wed_device_active(&dev->mt76.mmio.wed))
+	if (dev->dma_started)
+		mt7996_dma_cleanup(dev);
+	mt7996_wed_rro_free(dev);
+	if (mt7996_has_hwrro(dev) && !wed_active)
 		mt7996_rro_msdu_page_map_free(dev);
-	tasklet_disable(&dev->mt76.irq_tasklet);
-
-	mt76_free_device(&dev->mt76);
-}
