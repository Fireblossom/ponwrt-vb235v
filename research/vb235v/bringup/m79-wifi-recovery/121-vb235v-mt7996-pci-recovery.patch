 	return 0;
 }
 
+/* Keep dev and both BAR mappings alive until all interrupt consumers stop. */
+void mt7996_pci_quiesce(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+
+	WRITE_ONCE(dev->removing, true);
+	clear_bit(MT76_STATE_INITIALIZED, &dev->mphy.state);
+	mt76_wr(dev, MT_INT_MASK_CSR, 0);
+	if (dev->hif2)
+		mt76_wr(dev, MT_INT1_MASK_CSR, 0);
+	if (mtk_wed_device_active(&mdev->mmio.wed))
+		mtk_wed_device_irq_set_mask(&mdev->mmio.wed, 0);
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_irq_set_mask(&mdev->mmio.wed_hif2, 0);
+
+	/* Drain handlers which saw INITIALIZED before it was cleared, then their
+	 * tasklet. Later handlers see it clear and cannot schedule a new tasklet.
+	 */
+	if (dev->hif2_irq_requested)
+		synchronize_irq(dev->hif2_irq);
+	if (dev->pci_irq_requested)
+		synchronize_irq(dev->pci_irq);
+	tasklet_kill(&mdev->irq_tasklet);
+	/* A final tasklet may have re-enabled a mask while it was draining. */
+	mt76_wr(dev, MT_INT_MASK_CSR, 0);
+	if (dev->hif2)
+		mt76_wr(dev, MT_INT1_MASK_CSR, 0);
+	if (mtk_wed_device_active(&mdev->mmio.wed))
+		mtk_wed_device_irq_set_mask(&mdev->mmio.wed, 0);
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_irq_set_mask(&mdev->mmio.wed_hif2, 0);
+
+	if (dev->hif2_irq_requested) {
+		devm_free_irq(mdev->dev, dev->hif2_irq, dev);
+		dev->hif2_irq_requested = false;
+	}
+	if (dev->pci_irq_requested) {
+		devm_free_irq(mdev->dev, dev->pci_irq, dev);
+		dev->pci_irq_requested = false;
+	}
+}
+
+static void mt7996_pci_release(struct pci_dev *pdev, struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+
+	mt7996_pci_quiesce(dev);
+	/* DMA cleanup may already have detached WED. Never free WED-owned vectors. */
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_detach(&mdev->mmio.wed_hif2);
+	if (dev->hif2_irq_vectors) {
+		pci_free_irq_vectors(to_pci_dev(dev->hif2->dev));
+		dev->hif2_irq_vectors = false;
+	}
+	if (mtk_wed_device_active(&mdev->mmio.wed))
+		mtk_wed_device_detach(&mdev->mmio.wed);
+	if (dev->pci_irq_vectors) {
+		pci_free_irq_vectors(pdev);
+		dev->pci_irq_vectors = false;
+	}
+	mt7996_put_hif2(dev->hif2);
+	mt76_free_device(mdev);
+}
