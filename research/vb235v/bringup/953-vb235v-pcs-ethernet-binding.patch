From: VB235v research
Subject: [PATCH] dt-bindings: net: pcs: document AN7583 PON Ethernet profile

SPDX-License-Identifier: GPL-2.0-only

Apply after the pinned target patch stack and M14 development patches.
Keep the development nodes disabled. Hardware execution and complete
DSL compatibility have not been validated.

---
diff --git a/Documentation/devicetree/bindings/net/pcs/airoha,an7583-pcs-pon.yaml b/Documentation/devicetree/bindings/net/pcs/airoha,an7583-pcs-pon.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/pcs/airoha,an7583-pcs-pon.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/pcs/airoha,an7583-pcs-pon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7583 PON physical PCS
+
+maintainers:
+  - Christian Marangi <ansuelsmth@gmail.com>
+
+description: |
+  The AN7583 PON physical PCS supports optical operation and an optional
+  Ethernet USXGMII rate profile. The profile selects PMA rates independently
+  from the optical configuration API. This development binding does not
+  establish board wiring, endpoint discovery or DSL traffic compatibility.
+
+select:
+  anyOf:
+    - properties:
+        compatible:
+          contains:
+            const: airoha,an7583-pcs-pon
+      required:
+        - compatible
+    - required:
+        - airoha,pon-ethernet-mode
+
+properties:
+  compatible:
+    const: airoha,an7583-pcs-pon
+
+  reg:
+    items:
+      - description: PCS MAC register window
+      - description: HSGMII auto-negotiation register window
+      - description: HSGMII PCS register window
+      - description: Multi-SGMII register window
+      - description: USXGMII register window
+      - description: Rate adaptation register window
+      - description: Analog register window
+      - description: PMA register window
+
+  reg-names:
+    items:
+      - const: pcs_mac
+      - const: hsgmii_an
+      - const: hsgmii_pcs
+      - const: multi_sgmii
+      - const: usxgmii
+      - const: hsgmii_rate_adp
+      - const: pcs_ana
+      - const: pcs_pma
+
+  resets:
+    items:
+      - description: MAC reset
+      - description: PHY reset
+      - description: XFI reset
+
+  reset-names:
+    items:
+      - const: mac
+      - const: phy
+      - const: xfi
+
+  nvmem-cells:
+    items:
+      - description: Impedance calibration validity cell
+      - description: Transmit termination calibration cell
+      - description: Receive impedance calibration cell
+
+  nvmem-cell-names:
+    items:
+      - const: pon-impedance-valid
+      - const: pon-tx-term
+      - const: pon-rx-impedance
+
+  airoha,scu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: System control register provider
+
+  airoha,pon-ethernet-mode:
+    $ref: /schemas/types.yaml#/definitions/string
+    const: usxgmii
+    description: |
+      Opt into Ethernet USXGMII on the physical PON PCS. Absence preserves
+      optical behavior. Other interfaces and the optical configuration API
+      are rejected when this profile is selected.
+
+  '#pcs-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - resets
+  - reset-names
+  - nvmem-cells
+  - nvmem-cell-names
+  - airoha,scu
+  - '#pcs-cells'
+
+additionalProperties: false
