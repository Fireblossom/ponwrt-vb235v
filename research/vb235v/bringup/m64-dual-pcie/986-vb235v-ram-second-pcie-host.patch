+static int mtk_pcie_vb235v_port1_startup(struct mtk_pcie_port *port)
+{
+	struct mtk_pcie *pcie = port->pcie;
+	struct pci_host_bridge *host = pci_host_bridge_from_priv(pcie);
+	struct resource_entry *entry;
+	struct resource *mem;
+	struct regmap *pbus;
+	u32 val;
+	int err;
+
+	if (!of_machine_is_compatible("tplink,vb235v-ram-dual-pcie-development") ||
+	    port->phys_base != 0x1fa92000 || port->slot != 1 || !port->phy)
+		return -EINVAL;
+	entry = resource_list_first_type(&host->windows, IORESOURCE_MEM);
+	if (!entry)
+		return -EINVAL;
+	mem = entry->res;
+	if (mem->start != 0x24000000 || resource_size(mem) != 0x4000000 || entry->offset)
+		return -EINVAL;
+	pbus = syscon_regmap_lookup_by_phandle(pcie->dev->of_node, "airoha,pbus");
+	if (IS_ERR(pbus))
+		return PTR_ERR(pbus);
+	err = regmap_write(pbus, 8, 0x24000000);
+	if (err)
+		return err;
+	err = regmap_write(pbus, 12, 0xfc000000);
+	if (err)
+		return err;
+	/* QPHY provider has completed the original port-1 MAC/PERST sequence. */
+	writel(0x804201, port->base);
+	writel(0x06040001, port->base + 0x104);
+	err = readl_poll_timeout(port->base + PCIE_LINK_STATUS_V2, val,
+				 val & PCIE_PORT_LINKUP_V2, 20, 100000);
+	if (err)
+		return err;
+	/* Set INTx mask */
+	val = readl(port->base + PCIE_INT_MASK);
+	val &= ~INTX_MASK;
+	writel(val, port->base + PCIE_INT_MASK);
+
+	if (IS_ENABLED(CONFIG_PCI_MSI))
+		mtk_pcie_enable_msi(port);
+
+	/* Set AHB to PCIe translation windows */
+	val = lower_32_bits(mem->start) |
+	      AHB2PCIE_SIZE(fls(resource_size(mem)));
+	writel(val, port->base + PCIE_AHB_TRANS_BASE0_L);
+
+	val = upper_32_bits(mem->start);
+	writel(val, port->base + PCIE_AHB_TRANS_BASE0_H);
+
+	/* Set PCIe to AXI translation memory space.*/
+	val = PCIE2AHB_SIZE | WIN_ENABLE;
+	writel(val, port->base + PCIE_AXI_WINDOW0);
+
+	/* Original AN7583 controller coherence workaround. */
+	writel(readl(port->base + 0x564) | BIT(0), port->base + 0x564);
+	dev_info(pcie->dev, "VB235v port-1 RAM development host ready\n");
 	return 0;
 }
 
