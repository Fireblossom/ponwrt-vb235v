+/* Development-only RAM calibration input. Never use a reference EEPROM on
+ * the owner's board if this input is missing or has incompatible capabilities.
+ */
+static int mt7996_vb235v_development_calibration(struct mt7996_dev *dev)
+{
+	static const u8 conf[8] = { 0x11, 0x10, 0x03, 0x1a, 0x10, 0x02, 0x08, 0x08 };
+	const struct firmware *fw;
+	int ret;
+
+	if (!is_mt7990(&dev->mt76) || dev->var.fem != MT7996_FEM_INT)
+		return -EINVAL;
+	ret = request_firmware(&fw, "vb235v/mt7990-board-eeprom.bin", dev->mt76.dev);
+	if (ret)
+		return ret;
+	if (fw->size != MT7996_EEPROM_SIZE ||
+	    get_unaligned_le16(fw->data) != MT7990_DEVICE_ID ||
+	    memcmp(fw->data + MT_EE_WIFI_CONF, conf, sizeof(conf))) {
+		ret = -EINVAL;
+		goto out;
+	}
+	memcpy(dev->mt76.eeprom.data, fw->data, MT7996_EEPROM_SIZE);
+	dev->eeprom_mode = EEPROM_MODE_FLASH;
+	dev_info(dev->mt76.dev, "VB235v private ART EEPROM loaded; reference fallback disabled\n");
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
