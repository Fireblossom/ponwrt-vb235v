# Object compilation only; never a device configuration.
CONFIG_EXPERT=y
CONFIG_OF=y
CONFIG_ARCH_AIROHA=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AIROHA=y
CONFIG_NET_AIROHA=y
CONFIG_FW_LOADER=y
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_PCS_AIROHA_AN7583=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_RESET_CONTROLLER=y
CONFIG_NVMEM=y
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-vb235v-pcs-compile-dev"
CONFIG_LOCALVERSION_AUTO=n
